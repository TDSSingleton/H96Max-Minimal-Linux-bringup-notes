# Applied on top of generic-rk3528_defconfig by tools/build-uboot.sh, then
# EVERY line is checked against the resolved .config (a misspelt or dependency-
# blocked symbol is silently dropped by olddefconfig; the check makes that loud).
CONFIG_DEFAULT_DEVICE_TREE="rk3518-h96max"
CONFIG_DEFAULT_FDT_FILE="rk3518-h96max.dtb"
CONFIG_OF_LIST="rk3518-h96max"
CONFIG_SPL_OF_LIST="rk3518-h96max"
# the factory recovery button (saradc ch1) -> maskrom
CONFIG_ADC=y
CONFIG_SARADC_ROCKCHIP=y
# booting the AOSP v2 `boot` partition explicitly
CONFIG_ANDROID_BOOT_IMAGE=y
CONFIG_ANDROID_BOOT_IMAGE_IGNORE_BLOB_ADDR=y
CONFIG_CMD_ABOOTIMG=y
CONFIG_CMD_BOOTI=y
CONFIG_CMD_UNZIP=y
CONFIG_CMD_SETEXPR=y
CONFIG_CMD_FDT=y
CONFIG_CMD_PART=y
CONFIG_CMD_MMC=y
CONFIG_EFI_PARTITION=y
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTDELAY=0
# large single eMMC reads wedge on this family (X88PRO build uses the same cap)
CONFIG_SYS_MMC_MAX_BLK_COUNT=2048
# u-boot must never write the eMMC on its own: environment lives nowhere
CONFIG_ENV_IS_NOWHERE=y
# a host tool we never use that wants gnutls headers
# CONFIG_TOOLS_MKEFICAPSULE is not set
