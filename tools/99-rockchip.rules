# Rockchip Maskrom / Loader mode access for a non-root user.
#
# Deliberately matched on VENDOR only (2207 = Rockchip). The RK3518/RK3528
# Maskrom *product* id is not documented in any source we found -- upstream
# rkdeveloptool's own rules stop at 0x350a (RK3566) and a 2026 tooling PR
# explicitly left RK3528/RK3562 out as unconfirmed, while 0x350b is confirmed
# only for RK3588-class parts. Pinning a PID here would be a guess, so match
# the vendor and let the tool sort it out.
#
# uaccess hands the device to whoever is logged in on the seat (no world-writable
# node). If you are running over SSH or a display manager that does not do
# uaccess, swap the TAG line for:  MODE="0666", GROUP="users"
SUBSYSTEM=="usb", ATTR{idVendor}=="2207", TAG+="uaccess", ENV{ID_MM_DEVICE_IGNORE}="1"

# ADB, if you ever go down the network/USB-ADB path (you should not need it).
SUBSYSTEM=="usb", ATTR{idVendor}=="18d1", ATTR{idProduct}=="4e76", TAG+="uaccess"
