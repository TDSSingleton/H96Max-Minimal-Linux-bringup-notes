diff -ruN a/skwbt/skw_common.h b/skwbt/skw_common.h
--- a/skwbt/skw_common.h	2026-11-19 22:01:10.315468507 +0000
+++ b/skwbt/skw_common.h	2026-11-21 18:03:29.319959739 +0000
@@ -31,6 +31,12 @@
 
 #define SKW_CHIPID_6316 0x5301
 #define SKW_CHIPID_6160 0x0017
+/* H96Max: the SWT6621S ("SV6160LITE") BT side reports hci_rev 0x5302. The factory BT helper
+ * (libbt-vendor-seekwave.so) gives it sv6160lite.nvbin, which is byte-identical to sv6316.nvbin
+ * (the short packetised NV); the full 354-byte sv6160.nvbin crashed the chip's firmware. */
+#define SKW_CHIPID_6160LITE 0x5302
+#define NV_FILE_NAME_6160LITE    "sv6160lite.nvbin"
+#define SKW_SHORT_NV(v) ((v) == SKW_CHIPID_6316 || (v) == SKW_CHIPID_6160LITE)
 
 
 
diff -ruN a/skwifi/Kbuild b/skwifi/Kbuild
--- a/skwifi/Kbuild	1970-01-01 00:00:00.000000000 +0000
+++ b/skwifi/Kbuild	2026-11-21 14:00:25.355856713 +0000
@@ -0,0 +1,24 @@
+# External-module build of Neardi's skwifi (cfg80211 driver) for the H96Max SWT6621S.
+# Options = Neardi Kconfig defaults (CONFIG_WLAN_VENDOR_SKW6316=m), except:
+#   CHIP_ID "SWT6621S": the calibration file is then SWT6621S_SEEKWAVE_Rxxyyy.bin, which is
+#   what the ODM shipped (SWT6621S_SEEKWAVE_R00001.bin); this older table has no entry for
+#   our chip type and would fall back to "EA6652AS".
+obj-m += skw6316.o
+skw6316-objs := skw_core.o skw_iface.o skw_cfg80211.o skw_msg.o skw_rx.o skw_tx.o skw_regd.o \
+                skw_mlme.o skw_timer.o skw_log.o skw_iw.o skw_work.o skw_mbssid.o skw_dentry.o \
+                skw_util.o skw_recovery.o trace.o \
+                skw_calib.o skw_vendor.o skw_dfs.o
+ccflags-y += -I$(src)/../include -I$(src)/../include/linux/platform_data -I$(src)
+y := 1
+ccflags-y += $(foreach o,STA_SME_EXT SAP_SME_EXT SCAN_RANDOM_MAC TX_WORKQUEUE HIGH_PRIORITY \
+               VENDOR REGD_SELF_MANAGED DFS_MASTER 6GHZ CALIB_DPD CALIB_BUS_SENSITIVE LOG_DEBUG,\
+               -DCONFIG_SKW6316_$(o)=1)
+ccflags-y += -DCONFIG_SKW6316_RX_REORDER_TIMEOUT=100
+ccflags-y += '-DCONFIG_SKW6316_DEFAULT_COUNTRY=""'
+ccflags-y += '-DCONFIG_SKW6316_CHIP_ID="SWT6621S"'
+ccflags-y += '-DCONFIG_SKW6316_PROJECT_NAME="SEEKWAVE"'
+ccflags-y += -DCONFIG_WLAN_VENDOR_SKW6316_MODULE=1
+CFLAGS_trace.o := -I$(src)
+$(obj)/skw_core.o: $(obj)/version.h
+$(obj)/version.h: $(src)/genver.pl
+	@$(PERL) -s $(src)/genver.pl $@
