diff -ruN a/platform/Kbuild b/platform/Kbuild
--- a/platform/Kbuild	1970-01-01 00:00:00.000000000 +0000
+++ b/platform/Kbuild	2026-11-21 14:02:13.432080524 +0000
@@ -0,0 +1,13 @@
+# External-module build of Neardi's seekwaveplatform_v20 (SDIO HAL + chip boot) for the
+# H96Max SWT6621S (SDIO 1ffe:6621). Mirrors Makefile.neardi with Neardi's defconfig:
+#   CONFIG_SEEKWAVE_BSP_DRIVERS_V20=y  CONFIG_SEEKWAVE_PLD_RELEASE=y  CONFIG_SKW_SDIOHAL=m
+# (bools that Kconfig would have put in autoconf.h are passed as -D here)
+obj-m += skw_sdio_v20.o
+skw_sdio_v20-y := sdio/skw_sdio_main.o sdio/skw_sdio_rx.o sdio/skw_sdio_debugfs.o \
+                  sdio/skw_sdio_log.o skwutil/skw_user_com.o skwutil/skw_log_to_file.o \
+                  skwutil/skw_boot.o
+ccflags-y += -I$(src)/../include -I$(src)/sdio -I$(src)/skwutil
+ccflags-y += -DCONFIG_SEEKWAVE_BSP_DRIVERS_V20=1 -DCONFIG_SEEKWAVE_PLD_RELEASE=1
+ccflags-y += -DCONFIG_SKW_SDIOHAL_MODULE=1
+# skw_sdio_debugfs.c prints these two skwifi options; same values as skwifi/Kbuild
+ccflags-y += -DCONFIG_SKW6316_RX_REORDER_TIMEOUT=100 '-DCONFIG_SKW6316_CHIP_ID="SWT6621S"'
