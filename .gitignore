# H96 Max: track our scripts, sources, notes and docs. Keep downloads,
# device dumps, secrets and build outputs out of git.
#
# Cloned upstream repos are submodules (see .gitmodules) and are NOT listed
# here: git saves them as a commit pointer, never their contents. Ignoring
# them would stop `git add` from recording that pointer.

# --- Secrets ---------------------------------------------------------------
build/keys/
*_ed25519
*.pem
*.key

# --- Device dumps (30 GB+, and they hold the stock Android's data) ---------
recon/
recon-dump.log

# --- Downloads that aren't git clones -----------------------------------------
downloads/ddrbin_tool.py
downloads/ddrblobs/
research/kxn_rk3518_atv/
research/vendor-kernel-6.1.118.config

# --- Build outputs, logs and captures --------------------------------------
# build/ is all outputs, build logs and captures from the box; only the two
# small sources in it are kept.
build/*
!build/ccprobe/
!build/retired/
build/retired/*.dtb
tools/rootfs/payload/usr/local/bin/h96ui

# Test-run reports pulled off the stick
runattempts/

# Logs and captured tool output anywhere
*.log
tools/ab-*.txt
tools/rkdeveloptool-help.txt
tools/loaders/rb.txt
tools/loaders/ddr-banners.txt
tools/loaders/factory-loader/carve.txt
tools/loaders/factory-loader/factory-ddr-params.txt

# Images and firmware blobs anywhere outside vendor/ and tools/loaders/
*.img
!vendor/**/*.img
*.itb

# Kernel-module / C build products (e.g. tools/wifi/seekwave)
*.o
*.ko
*.mod
*.mod.c
*.cmd
.*.cmd
*.order
*.symvers
.tmp_versions/
tools/rkbt-build/

# --- Python / editor junk -------------------------------------------------
__pycache__/
*.pyc
*.swp
*~
.claude/settings.local.json

# --- SeekWave WiFi/BT: Neardi's code is not redistributed here ------------
# tools/wifi/seekwave/ is regenerated by tools/wifi/prepare-seekwave.sh from the Neardi
# submodule + tools/wifi/seekwave-h96max.patch (our changes); the BT NV files in the
# rootfs payload are copied from the same submodule.
tools/wifi/seekwave/
tools/wifi/neardi-orig/
tools/wifi/.seekwave.*/
tools/rootfs/payload/lib/firmware/sv6160.nvbin
tools/rootfs/payload/lib/firmware/sv6160lite.nvbin
# Ripped from the stick's own Android vendor partitions (firmware, reference .ko);
# make-inbox.sh needs vendor/seekwave/firmware/SWT6621S_*.bin to be present locally.
vendor/seekwave/

# cargo test/run on the PC (box builds go to build/rust/target via build.sh)
tools/h96ui-rs/target/
